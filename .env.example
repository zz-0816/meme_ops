# Runtime
APP_ENV=development
PORT=8788
JWT_SECRET=
DATABASE_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_PUBLIC_URL=http://127.0.0.1:8788

# Text analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=90
# Reuse the same verified market/social snapshot when switching perspectives.
ANALYSIS_DATA_CACHE_SECONDS=90

# Social account binding and collection
# Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key after deployment; changing it makes existing OAuth tokens unreadable.
SOCIAL_TOKEN_ENCRYPTION_KEY=

# X OAuth 2.0 app credentials. Callback:
# ${APP_PUBLIC_URL}/api/social/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
# Keep false for the normal X Web App configuration. Set true only when the
# X developer app is explicitly configured as a public OAuth 2.0 PKCE client.
X_OAUTH_PUBLIC_CLIENT=false
X_OAUTH_SCOPES=tweet.read users.read follows.read offline.access

# Optional app-level read token for scheduled Top-100 collection.
# When blank, a user's OAuth token is used only for that wallet's on-demand asset.
X_BEARER_TOKEN=

# Telegram Login Widget + Bot API. Login callback:
# ${APP_PUBLIC_URL}/api/social/telegram/callback
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_AUTO_SET_WEBHOOK=false

# Works locally in the API process. For Railway, use one scheduler worker or
# leave this false and run scripts/social_collector.py from a Cron service.
SOCIAL_SCHEDULER_ENABLED=false
SOCIAL_SCHEDULER_INTERVAL_SECONDS=900
SOCIAL_ASSET_UNIVERSE_SIZE=100
SOCIAL_COLLECTOR_CONCURRENCY=4

# Generated Poster NFT backgrounds: auto | openai | gemini | stability
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=core

# Required before minting an AI raster poster, so image and metadata use IPFS
PINATA_JWT=

# Optional alternative when PINATA_JWT is blank: direct on-chain JSON/data URI.
# Larger metadata costs substantially more Gas; payloads above the hard limit are blocked.
ONCHAIN_METADATA_WARNING_BYTES=12000
ONCHAIN_METADATA_MAX_BYTES=24000

# Existing NFT deployment
NFT_CONTRACT_ADDRESS=
NFT_CHAIN=monad-testnet
NFT_CHAIN_ID=10143
NFT_EXPLORER_URL=https://testnet.monadexplorer.com
