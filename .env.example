# Text analysis
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Generated Poster NFT backgrounds: auto | openai | gemini | stability
IMAGE_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=core

# Required before minting an AI raster poster, so image and metadata use IPFS
PINATA_JWT=

# Optional alternative when PINATA_JWT is blank: direct on-chain JSON/data URI.
# Larger metadata costs substantially more Gas; payloads above the hard limit are blocked.
ONCHAIN_METADATA_WARNING_BYTES=12000
ONCHAIN_METADATA_MAX_BYTES=24000

# Existing NFT deployment
NFT_CONTRACT_ADDRESS=
NFT_CHAIN=monad-testnet
NFT_CHAIN_ID=10143
NFT_EXPLORER_URL=https://testnet.monadexplorer.com
